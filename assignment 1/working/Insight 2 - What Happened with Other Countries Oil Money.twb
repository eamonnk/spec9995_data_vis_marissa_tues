              <calculation class='tableau' formula='CASE [feature_name]&#13;&#10;WHEN &quot;ct&quot; THEN &quot;Ireland – Corporation Tax&quot;&#13;&#10;WHEN &quot;noroil_ord_plus_special_tax_eur&quot; THEN &quot;Norway – Oil Tax&quot;&#13;&#10;WHEN &quot;ukoil_total_net_revenue_eur&quot; THEN &quot;UK – Oil &amp; Gas Tax&quot;&#13;&#10;WHEN &quot;nlgas_total_revenue_real&quot; THEN &quot;Netherlands – Gas Revenue&quot;&#13;&#10;END' />
