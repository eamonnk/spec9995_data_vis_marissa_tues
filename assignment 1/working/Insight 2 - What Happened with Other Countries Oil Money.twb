    <worksheet name='Insight 1 - Has irleland Struck &quot;Oil&quot;?'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Insight 1 - Has Ireland struck &quot;Oil&quot;?
</run>
            <run bold='true' fontalignment='1' fontcolor='#59a14f'>Irish Corporation Tax</run>
            <run fontalignment='1'><![CDATA[ vs NO/UK/NL Oil & Gas Windfalls (€ billion) - Norway: <[Parameters].[Parameter 2141910119895058]>]]></run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#1b1b1b'>Norway Petroleum Tax  (22% + 71.8%), or toggle to view all revenue including dividends.UK HMRC total oil and gas tax.Netherlands, total gas revenue, data only available until 2021. All converted to ECB euro rates. Norway Inflation adjusted, UK and Netherlands, not inflation adjusted. Ireland had greater tax income than Norway in 2016, 2017,  2020 and 2021, e.g. 2020: €12bn vs €3.2 bn / 2021 €15.3bn vs €9.2bn. Toggle affects onyl Norway data.UK and irl are as tax collectors only. Nor and NL are as tax colectors and owners.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='df_cso_ifac_noroil_ukoil_nlgas' name='federated.1p74xg80thz54r1bquqiy08jgllp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Income View' datatype='string' name='[Parameter 2141910119895058]' param-domain-type='list' role='measure' type='nominal' value='&quot;Tax only&quot;'>
              <calculation class='tableau' formula='&quot;Tax only&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p74xg80thz54r1bquqiy08jgllp'>
            <column caption='Value ( € Billion )' datatype='real' name='[Calculation_2141908584284160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[value] / 1000' />
            </column>
            <column caption='Insight 1 Show:' datatype='boolean' name='[Calculation_2141910120321043]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [feature_name] = &quot;ct&quot;&#13;&#10;OR [feature_name] = &quot;ct_diff_from_xpctd&quot;&#13;&#10;OR [feature_name] = &quot;ukoil_total_net_revenue_eur&quot;&#13;&#10;OR [feature_name] = &quot;nlgas_total_revenue&quot;&#13;&#10;THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 2141910119895058] = &quot;Tax only&quot; THEN [feature_name] = &quot;noroil_ord_plus_special_tax_eur&quot;&#13;&#10;ELSE [feature_name] = &quot;noroil_state_net_cash_flow_eur&quot;&#13;&#10;END' />
            </column>
            <column caption='Insight 1 Series' datatype='string' name='[Calculation_2141910121365525]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [feature_name]&#13;&#10;WHEN &quot;ct&quot; THEN &quot;Ireland – Corporation Tax&quot;&#13;&#10;WHEN &quot;ct_diff_from_xpctd&quot; THEN &quot;Ireland – Excess CT (windfall)&quot;&#13;&#10;WHEN &quot;noroil_ord_plus_special_tax_eur&quot; THEN &quot;Norway&quot;&#13;&#10;WHEN &quot;noroil_state_net_cash_flow_eur&quot; THEN &quot;Norway&quot;&#13;&#10;WHEN &quot;ukoil_total_net_revenue_eur&quot; THEN &quot;UK&quot;&#13;&#10;WHEN &quot;nlgas_total_revenue&quot; THEN &quot;Netherlands&quot;&#13;&#10;END' />
            </column>
            <column caption='Feature Name' datatype='string' name='[feature_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2141910120321043]' derivation='None' name='[none:Calculation_2141910120321043:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2141910121365525]' derivation='None' name='[none:Calculation_2141910121365525:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2141908584284160]' derivation='Sum' name='[sum:Calculation_2141908584284160:qk]' pivot='key' type='quantitative' />
            <column caption='Value' datatype='real' name='[value]' role='measure' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1p74xg80thz54r1bquqiy08jgllp].[none:Calculation_2141910120321043:nk]'>
