    <worksheet name='Revenue Growth '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Revenue Growth since 2000 -  </run>
            <run bold='true' fontalignment='1' fontcolor='#f1ce63' underline='true'>Corporation Tax </run>
            <run fontalignment='1'>vs Total Revenue and Other Taxes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='df_cso_ifac_noroil_ukoil_nlgas' name='federated.1p74xg80thz54r1bquqiy08jgllp' />
          </datasources>
          <datasource-dependencies datasource='federated.1p74xg80thz54r1bquqiy08jgllp'>
            <column caption='Revenue Growth index' datatype='real' name='[Calculation_2141908725907468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([value]) /&#13;&#10;SUM({FIXED [feature_name] : SUM(IF [year] = 2000 THEN [value] END)}) * 100' />
            </column>
            <column caption='Feature Name' datatype='string' name='[feature_name]' role='dimension' type='nominal' />
            <column-instance column='[feature_name]' derivation='None' name='[none:feature_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2141908725907468]' derivation='User' name='[usr:Calculation_2141908725907468:qk]' pivot='key' type='quantitative' />
            <column caption='Value' datatype='real' name='[value]' role='measure' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1p74xg80thz54r1bquqiy08jgllp].[none:feature_name:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:feature_name:nk]' member='&quot;ct&quot;' />
              <groupfilter function='member' level='[none:feature_name:nk]' member='&quot;income_tax&quot;' />
