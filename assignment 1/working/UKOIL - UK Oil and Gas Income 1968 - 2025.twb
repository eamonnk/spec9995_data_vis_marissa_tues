    <worksheet name='Tax Growth % since 2000'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Tax Growth % since 2000 &#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#f1ce63' underline='true'>Corporation Tax </run>
            <run fontalignment='1'>vs </run>
            <run bold='true' fontalignment='1' fontcolor='#b07aa1'>Total Tax</run>
            <run fontalignment='1' fontcolor='#4e79a7'>, </run>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7'>Income Tax, </run>
            <run bold='true' fontalignment='1' fontcolor='#e15759'>VAT </run>
            <run fontalignment='1'>and </run>
            <run bold='true' fontalignment='1' fontcolor='#ff9d9a'>Other Taxes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='df_cso_ifac_noroil_ukoil' name='federated.0kx65xy025nnlo10cu1f917oph3i' />
          </datasources>
          <datasource-dependencies datasource='federated.0kx65xy025nnlo10cu1f917oph3i'>
            <column caption='Value ( € Billion )' datatype='real' name='[Calculation_2141908584284160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[value] / 1000' />
            </column>
            <column caption='Revenus Growth %' datatype='real' name='[Calculation_2141909211111438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([value]) /&#13;&#10; SUM({FIXED [feature_name] : SUM(IF [year] = 2000 THEN [value] END)}) - 1) * 100' />
            </column>
            <column caption='Feature Name' datatype='string' name='[feature_name]' role='dimension' type='nominal' />
            <column-instance column='[feature_name]' derivation='None' name='[none:feature_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2141908584284160]' derivation='Sum' name='[sum:Calculation_2141908584284160:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2141909211111438]' derivation='User' name='[usr:Calculation_2141909211111438:qk]' pivot='key' type='quantitative' />
            <column caption='Value' datatype='real' name='[value]' role='measure' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0kx65xy025nnlo10cu1f917oph3i].[none:feature_name:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:feature_name:nk]' member='&quot;ct&quot;' />
              <groupfilter function='member' level='[none:feature_name:nk]' member='&quot;income_tax&quot;' />
              <groupfilter function='member' level='[none:feature_name:nk]' member='&quot;other_tax&quot;' />
              <groupfilter function='member' level='[none:feature_name:nk]' member='&quot;total_tax&quot;' />
              <groupfilter function='member' level='[none:feature_name:nk]' member='&quot;vat&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.0kx65xy025nnlo10cu1f917oph3i].[none:year:qk]' included-values='in-range'>
            <min>2000</min>
            <max>2025</max>
          </filter>
          <slices>
            <column>[federated.0kx65xy025nnlo10cu1f917oph3i].[none:feature_name:nk]</column>
            <column>[federated.0kx65xy025nnlo10cu1f917oph3i].[none:year:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0kx65xy025nnlo10cu1f917oph3i].[usr:Calculation_2141909211111438:qk]' scope='rows' value='% Tax Growth since 2000' />
            <encoding attr='space' class='0' field='[federated.0kx65xy025nnlo10cu1f917oph3i].[none:year:qk]' field-type='quantitative' major-origin='2000' major-spacing='5' max='2025' min='2000' range-type='fixed' scope='cols' type='space' />
          </style-rule>
