  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='EDA Dashboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Has Ireland Struck Oil? - Exploratory Data Analysis</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='df_cso_ifac_noroil_ukoil_nlgas' name='federated.1p74xg80thz54r1bquqiy08jgllp' />
      </datasources>
      <datasource-dependencies datasource='federated.1p74xg80thz54r1bquqiy08jgllp'>
        <column caption='Feature Name' datatype='string' name='[feature_name]' role='dimension' type='nominal' />
        <column-instance column='[feature_name]' derivation='None' name='[none:feature_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[orig_org_source]' derivation='None' name='[none:orig_org_source:nk]' pivot='key' type='nominal' />
        <column caption='Orig Org Source' datatype='string' name='[orig_org_source]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='49200' id='11' param='horz' type-v2='layout-flow' w='98858' x='571' y='800'>
            <zone h='49200' id='5' param='vert' type-v2='layout-flow' w='98858' x='571' y='800'>
              <zone h='4200' id='7' type-v2='title' w='98858' x='571' y='800'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='5900' id='8' type-v2='text' w='98858' x='571' y='5000'>
                <formatted-text>
                  <run>This dashboard is for exploratory analysis (EDA) and shows 51 features from 5 different sources, (CSO, IFAC, Norwegian Ministry of Finance, UK&apos;s HMRC and the Netherlands&apos; Central Bureau of Statistics (CBS)). The data ranges over years from 1968 to 2030. Use the </run>
                  <run bold='true'>Data Overview</run>
                  <run> tile to get a high level overview of the data coverage and types of data that are available, and the </run>
                  <run bold='true'>EDA - Feature Explorer</run>
                  <run> tile to  explore individual features in more detail. The </run>
                  <run bold='true'>Total Tax Composition %</run>
                  <run> tile provides a breakdown of the elements that make up Ireland&apos;s tax take per year, and the </run>
                  <run bold='true'>Budget Surplus  and Deficit </run>
                  <run>tile provides details on  surplus and deficit per year. Also note that the 2026 - 2030 values are forecast values from the IFAC.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
