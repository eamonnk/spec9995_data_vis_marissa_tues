      <aliases enabled='yes' />
      <column caption='Value ( € Billion )' datatype='real' name='[Calculation_2141908584284160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[value] / 1000' />
      </column>
      <column caption='Surplus or Deficit' datatype='string' name='[Calculation_2141908591374337]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([value]) &gt;= 0 THEN &quot;Surplus&quot; ELSE &quot;Deficit&quot; END' />
      </column>
      <column caption='Corporation Tax (€ bn)' datatype='real' name='[Calculation_2141908619132930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feature_name] = &quot;ct&quot; THEN [value] END) / 1000' />
      </column>
      <column caption='Income Tax (€ bn)' datatype='real' name='[Calculation_2141908619304963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feature_name] = &quot;income_tax&quot; THEN [value] END) / 1000' />
      </column>
      <column caption='VAT (€ bn)' datatype='real' name='[Calculation_2141908619407364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feature_name] = &quot;vat&quot; THEN [value] END) / 1000' />
      </column>
      <column caption='Other Taxes (€ bn)' datatype='real' name='[Calculation_2141908619489285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feature_name] = &quot;total_tax&quot; THEN [value] END) / 1000 - [Calculation_2141908619132930] - [Calculation_2141908619304963] - [Calculation_2141908619407364]' />
      </column>
      <column caption='Total Tax (€ bn)' datatype='real' name='[Calculation_2141908634656774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feature_name] = &quot;total_tax&quot; THEN [value] END) / 1000' />
      </column>
      <column caption='Corporation Tax % of Tot Tax' datatype='real' name='[Calculation_2141908634849287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2141908619132930] / [Calculation_2141908634656774]' />
      </column>
      <column caption='Income Tax % of Tot Tax ' datatype='real' name='[Calculation_2141908635066376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2141908619304963] / [Calculation_2141908634656774]' />
      </column>
      <column caption='VAT % of Tot Tax' datatype='real' name='[Calculation_2141908635209737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2141908619407364] / [Calculation_2141908634656774]' />
      </column>
      <column caption='Other Taxes % of Tot Tax' datatype='real' name='[Calculation_2141908635299850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2141908619489285] / [Calculation_2141908634656774]' />
      </column>
      <column caption='Revenue Growth index' datatype='real' name='[Calculation_2141908725907468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([value]) /&#13;&#10;SUM({FIXED [feature_name] : SUM(IF [year] = 2000 THEN [value] END)}) * 100' />
      </column>
      <column caption='Revenus Growth %' datatype='real' name='[Calculation_2141909211111438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([value]) /&#13;&#10; SUM({FIXED [feature_name] : SUM(IF [year] = 2000 THEN [value] END)}) - 1) * 100' />
      </column>
