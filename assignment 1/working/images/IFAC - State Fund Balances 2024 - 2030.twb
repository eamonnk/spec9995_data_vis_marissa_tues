                <alias key='&quot;ifac_isif_balance&quot;' value='ISIF Balance' />
                <alias key='&quot;ifac_ntf_balance&quot;' value='NTF Balance' />
                <alias key='&quot;ifac_sif_balance&quot;' value='SIF Balance' />
