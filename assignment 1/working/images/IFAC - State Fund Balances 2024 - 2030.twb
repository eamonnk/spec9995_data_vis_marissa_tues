    <worksheet name='Tax Growth % since 2000'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Tax Growth % since 2000 &#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#f1ce63' underline='true'>Corporation Tax </run>
            <run fontalignment='1'>vs </run>
            <run bold='true' fontalignment='1' fontcolor='#b07aa1'>Total Tax</run>
            <run fontalignment='1' fontcolor='#4e79a7'>, </run>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7'>Income Tax, </run>
            <run bold='true' fontalignment='1' fontcolor='#e15759'>VAT </run>
            <run fontalignment='1'>and </run>
            <run bold='true' fontalignment='1' fontcolor='#ff9d9a'>Other Taxes</run>
