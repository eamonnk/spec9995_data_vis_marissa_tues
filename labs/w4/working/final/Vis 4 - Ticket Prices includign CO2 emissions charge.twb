              <bucket>&quot;London-Marseille&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.0nc4atj0u0icf51017vfj1cgyauo].[none:WeeksAhead:ok]'>
            <groupfilter function='member' level='[none:WeeksAhead:ok]' member='4' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
