    <worksheet name='vis 5 - Train vs Plane : T, Euro, COP2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Train Values as a % of Plane Values for CO2, Price and Time</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#00a3ff' fontname='Benton Sans Book' fontsize='16'>Train</run>
            <run fontalignment='1' fontcolor='#00a3ff' fontname='Benton Sans Book' fontsize='16'>Æ </run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>as a % of </run>
            <run bold='true' fontalignment='1' fontcolor='#d6471f' fontname='Benton Sans Book' fontsize='16'>Plane.</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Æ </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Below 100% and the train is better</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Note: </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Time includes 3 hour airport transfer</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Proce includes 0.489 euro #/kg carbon tax cost. </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Booked 4 weeks ahead </run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Flights-Trains' name='federated.0nc4atj0u0icf51017vfj1cgyauo' />
          </datasources>
          <datasource-dependencies datasource='federated.0nc4atj0u0icf51017vfj1cgyauo'>
            <column caption='Time Index' datatype='real' default-format='p0%' name='[Calculation_0788680100429835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Mode]=&apos;Train&apos; THEN [Raw travel time] END)&#13;&#10;/ (AVG(IF [Mode]=&apos;Plane&apos; THEN [Raw travel time] END) + 180)' />
            </column>
            <column caption='Price Index' datatype='real' default-format='p0%' name='[Calculation_0788680100528140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Mode]=&apos;Train&apos; THEN [Ticket price] + [EcoPassengerCO2]*0.489 END)&#13;&#10;/ AVG(IF [Mode]=&apos;Plane&apos; THEN [Ticket price] + [EcoPassengerCO2]*0.489 END)' />
            </column>
            <column caption='CO2 Index' datatype='real' default-format='p0%' name='[Calculation_0788680100573197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Mode]=&apos;Train&apos; THEN [EcoPassengerCO2] END)&#13;&#10;/ AVG(IF [Mode]=&apos;Plane&apos; THEN [EcoPassengerCO2] END)' />
            </column>
            <column datatype='integer' name='[EcoPassengerCO2]' role='measure' type='quantitative' />
            <column datatype='string' name='[Mode]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Raw travel time]' role='measure' type='quantitative' />
            <column datatype='string' name='[Route]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Berlin-Warsaw&quot;' value='Berlin-Warsaw                      (517 km)' />
                <alias key='&quot;London-Amsterdam&quot;' value='London-Amsterdam        (357 km)' />
                <alias key='&quot;London-Marseille&quot;' value='London-Marseille               (977 km)' />
                <alias key='&quot;Munich-Budapest&quot;' value='Munich-Budapest               (562 km)' />
                <alias key='&quot;Paris-Barcelona&quot;' value='Paris-Barcelona                      (826 km)' />
                <alias key='&quot;Zurich-Milan&quot;' value='Zurich-Milan                             (217 km)' />
              </aliases>
            </column>
            <column datatype='integer' name='[Ticket price]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Weeks Ahead' datatype='integer' name='[WeeksAhead]' role='dimension' type='ordinal' />
            <column-instance column='[Route]' derivation='None' name='[none:Route:nk]' pivot='key' type='nominal' />
            <column-instance column='[WeeksAhead]' derivation='None' name='[none:WeeksAhead:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0788680100429835]' derivation='User' name='[usr:Calculation_0788680100429835:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0788680100528140]' derivation='User' name='[usr:Calculation_0788680100528140:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0788680100573197]' derivation='User' name='[usr:Calculation_0788680100573197:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0nc4atj0u0icf51017vfj1cgyauo].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0nc4atj0u0icf51017vfj1cgyauo].[usr:Calculation_0788680100573197:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0nc4atj0u0icf51017vfj1cgyauo].[usr:Calculation_0788680100528140:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0nc4atj0u0icf51017vfj1cgyauo].[usr:Calculation_0788680100429835:qk]&quot;' />
            </groupfilter>
