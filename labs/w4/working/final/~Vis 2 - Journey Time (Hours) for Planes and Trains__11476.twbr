    <worksheet name='Vis 2 - Journey Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Journey Time (Hours) for Planes and Trains</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontalignment='1' fontsize='16'>Airport Transit Time of 3 Hours have been added to plane time to account for airport transfer time and provide comprehensive time comparison.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Flights-Trains' name='federated.0nc4atj0u0icf51017vfj1cgyauo' />
          </datasources>
          <datasource-dependencies datasource='federated.0nc4atj0u0icf51017vfj1cgyauo'>
            <column caption='Journey Time Hours' datatype='real' name='[Calculation_0788680054775809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Raw travel time]) / 60' />
            </column>
            <column caption='Airport Transit Time  (hours) ' datatype='integer' name='[Calculation_0788680057565186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN 3 END' />
            </column>
            <column caption='Plane flight Time (Hours)' datatype='real' name='[Calculation_0788680058159107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN [Calculation_0788680054775809] END' />
            </column>
            <column caption='Train Time (Hours)' datatype='real' name='[Calculation_0788680058294276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Train&apos; THEN [Calculation_0788680054775809] END' />
            </column>
            <column datatype='string' name='[Mode]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Raw travel time]' role='measure' type='quantitative' />
            <column datatype='string' name='[Route]' role='dimension' type='nominal'>
              <aliases>
