    <worksheet name='Vis 4 - Price vs CO2 emissions cost'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Ticket price including Carbon Tax Cost</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Note : For our calculations, DW has used a figure of $574 (489 euros), based on research published by Ireland&apos;s Economic and Social Research Institute as per the article.</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Using the cheapest one-way fare 4 weeks ahead. Carbon cost = CO2 per passenger × €0.489/kg (€489/tonne, as used by DW,</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Flights-Trains' name='federated.0nc4atj0u0icf51017vfj1cgyauo' />
          </datasources>
          <datasource-dependencies datasource='federated.0nc4atj0u0icf51017vfj1cgyauo'>
            <column caption='Plane Ticket (Euro)' datatype='real' name='[Calculation_0788680090361862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN AVG([Ticket price]) END' />
            </column>
            <column caption='Plane Carbon Cost (Euro)' datatype='real' name='[Calculation_0788680090476551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN AVG([EcoPassengerCO2]) * 0.489 END' />
            </column>
            <column caption='Train Ticket (Euro)' datatype='real' name='[Calculation_0788680090648584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Train&apos; THEN AVG([Ticket price]) END' />
            </column>
            <column caption='Train Carbon Cost (Euro)' datatype='real' name='[Calculation_0788680090771465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Train&apos; THEN AVG([EcoPassengerCO2]) * 0.489 END' />
            </column>
            <column caption='Total price incl. carbon (€)' datatype='real' name='[Calculation_0788680095182858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Ticket price]) + AVG([EcoPassengerCO2]) * 0.489' />
            </column>
            <column datatype='integer' name='[EcoPassengerCO2]' role='measure' type='quantitative' />
            <column datatype='string' name='[Mode]' role='dimension' type='nominal' />
            <column datatype='string' name='[Route]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Berlin-Warsaw&quot;' value='Berlin-Warsaw                      (517 km)' />
                <alias key='&quot;London-Amsterdam&quot;' value='London-Amsterdam        (357 km)' />
                <alias key='&quot;London-Marseille&quot;' value='London-Marseille               (977 km)' />
                <alias key='&quot;Munich-Budapest&quot;' value='Munich-Budapest               (562 km)' />
                <alias key='&quot;Paris-Barcelona&quot;' value='Paris-Barcelona                      (826 km)' />
                <alias key='&quot;Zurich-Milan&quot;' value='Zurich-Milan                             (217 km)' />
              </aliases>
            </column>
            <column datatype='integer' name='[Ticket price]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Weeks Ahead' datatype='integer' name='[WeeksAhead]' role='dimension' type='ordinal' />
            <column-instance column='[Mode]' derivation='None' name='[none:Mode:nk]' pivot='key' type='nominal' />
            <column-instance column='[Route]' derivation='None' name='[none:Route:nk]' pivot='key' type='nominal' />
