      <aliases enabled='yes' />
      <column caption='Price Gap' datatype='integer' name='[Calculation_0788680039833600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Mode]=&apos;Plane&apos; THEN [Ticket price] END)&#13;&#10;- SUM(IF [Mode]=&apos;Train&apos; THEN [Ticket price] END)' />
      </column>
      <column caption='Journey Time Hours' datatype='real' name='[Calculation_0788680054775809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Raw travel time]) / 60' />
      </column>
      <column caption='Airport Transit Time  (hours) ' datatype='integer' name='[Calculation_0788680057565186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN 3 END' />
      </column>
      <column caption='Plane flight Time (Hours)' datatype='real' name='[Calculation_0788680058159107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN [Calculation_0788680054775809] END' />
      </column>
      <column caption='Train Time (Hours)' datatype='real' name='[Calculation_0788680058294276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Train&apos; THEN [Calculation_0788680054775809] END' />
      </column>
      <column caption='Airport Transit Time (Hours)' datatype='integer' name='[Calculation_0788680058368005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN 3 END' />
      </column>
      <column caption='Plane Ticket (Euro)' datatype='real' name='[Calculation_0788680090361862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN AVG([Ticket price]) END' />
      </column>
      <column caption='Plane Carbon Cost (Euro)' datatype='real' name='[Calculation_0788680090476551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Plane&apos; THEN AVG([EcoPassengerCO2]) * 0.489 END' />
      </column>
      <column caption='Train Ticket (Euro)' datatype='real' name='[Calculation_0788680090648584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Train&apos; THEN AVG([Ticket price]) END' />
      </column>
      <column caption='Train Carbon Cost (Euro)' datatype='real' name='[Calculation_0788680090771465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Mode])=&apos;Train&apos; THEN AVG([EcoPassengerCO2]) * 0.489 END' />
      </column>
      <column caption='Total price incl. carbon (€)' datatype='real' name='[Calculation_0788680095182858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Ticket price]) + AVG([EcoPassengerCO2]) * 0.489' />
      </column>
      <column caption='Time Index' datatype='real' name='[Calculation_0788680100429835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Mode]=&apos;Train&apos; THEN [Raw travel time] END)&#13;&#10;/ (AVG(IF [Mode]=&apos;Plane&apos; THEN [Raw travel time] END) + 180)' />
      </column>
      <column caption='Price Index' datatype='real' name='[Calculation_0788680100528140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Mode]=&apos;Train&apos; THEN [Ticket price] + [EcoPassengerCO2]*0.489 END)&#13;&#10;/ AVG(IF [Mode]=&apos;Plane&apos; THEN [Ticket price] + [EcoPassengerCO2]*0.489 END)' />
      </column>
      <column caption='CO2 Index' datatype='real' name='[Calculation_0788680100573197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Mode]=&apos;Train&apos; THEN [EcoPassengerCO2] END)&#13;&#10;/ AVG(IF [Mode]=&apos;Plane&apos; THEN [EcoPassengerCO2] END)' />
      </column>
      <column datatype='integer' name='[EcoPassengerCO2]' role='measure' type='quantitative' />
      <column datatype='string' name='[Mode]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Raw travel time]' role='measure' type='quantitative' />
      <column datatype='string' name='[Route]' role='dimension' type='nominal'>
