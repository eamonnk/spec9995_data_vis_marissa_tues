      <column aggregation='None' caption='Age (5 Year bins)' datatype='integer' name='[Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[age]' peg='0' size='5' />
      </column>
      <column caption='Workclass Null' datatype='boolean' name='[Calculation_0875543909318656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([workclass])' />
      </column>
      <column caption='Occupation Null' datatype='boolean' name='[Calculation_0875543925911553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([occupation])' />
      </column>
      <column caption='Native Country missing' datatype='boolean' name='[Calculation_0875543944421378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([native_country])' />
      </column>
      <column caption='Country Group' datatype='string' name='[Calculation_0875543964782595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([native_country]) THEN &apos;Missing&apos;&#13;&#10;   ELSEIF [native_country] = &apos;United-States&apos; THEN &apos;United States&apos;&#13;&#10;   ELSEIF [native_country] = &apos;Mexico&apos; THEN &apos;Mexico&apos;&#13;&#10;   ELSE &apos;Other countries&apos;&#13;&#10;   END' />
      </column>
      <column caption='Education Level' datatype='string' name='[Calculation_0875543964954628]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [education_num] &lt;= 8 THEN &apos;1 Below HS&apos;&#13;&#10;   ELSEIF [education_num] = 9 THEN &apos;2 HS-grad&apos;&#13;&#10;   ELSEIF [education_num] &lt;= 12 THEN &apos;3 Some college / Assoc&apos;&#13;&#10;   ELSE &apos;4 Bachelors+&apos;&#13;&#10;   END' />
      </column>
      <column aggregation='None' caption='Capital Gain (Dollars $  - 5K bins)' datatype='integer' name='[Capital Gain (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='3' formula='[capital_gain]' peg='0' size='5000' />
      </column>
      <column aggregation='None' caption='Capital Loss (Dollars $  - 250 bins)' datatype='integer' name='[Capital Loss (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='2' formula='[capital_loss]' peg='0' size='250' />
      </column>
      <column aggregation='None' caption='Fnlwgt (50K bins)' datatype='integer' name='[Fnlwgt (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='4' formula='[fnlwgt]' peg='0' size='50000' />
      </column>
      <column aggregation='None' caption='Hours Worked Per Week ( 5 Hour bins)' datatype='integer' name='[Hours Per Week (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[hours_per_week]' peg='0' size='5' />
      </column>
