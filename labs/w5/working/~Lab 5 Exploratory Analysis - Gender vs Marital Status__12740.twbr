    <worksheet name='Education by Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Education Levels Attained per Native Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='adult_converted' name='federated.0majz1a18968a71aozgur0vm611d' />
          </datasources>
          <datasource-dependencies datasource='federated.0majz1a18968a71aozgur0vm611d'>
            <column caption='Country Group' datatype='string' name='[Calculation_0875543964782595]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([native_country]) THEN &apos;Missing&apos;&#13;&#10;   ELSEIF [native_country] = &apos;United-States&apos; THEN &apos;United States&apos;&#13;&#10;   ELSEIF [native_country] = &apos;Mexico&apos; THEN &apos;Mexico&apos;&#13;&#10;   ELSE &apos;Other countries&apos;&#13;&#10;   END' />
            </column>
            <column caption='Education Level' datatype='string' name='[Calculation_0875543964954628]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [education_num] &lt;= 8 THEN &apos;1 Below HS&apos;&#13;&#10;   ELSEIF [education_num] = 9 THEN &apos;2 HS-grad&apos;&#13;&#10;   ELSEIF [education_num] &lt;= 12 THEN &apos;3 Some college / Assoc&apos;&#13;&#10;   ELSE &apos;4 Bachelors+&apos;&#13;&#10;   END' />
            </column>
            <column caption='adult_converted.csv' datatype='table' name='[__tableau_internal_object_id__].[adult_converted.csv_7120295E822D483F82FF342C3A717F56]' role='measure' type='quantitative' />
            <column caption='Education Num' datatype='integer' name='[education_num]' role='dimension' type='ordinal' />
            <column caption='Native Country' datatype='string' name='[native_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_0875543964782595]' derivation='None' name='[none:Calculation_0875543964782595:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0875543964954628]' derivation='None' name='[none:Calculation_0875543964954628:nk]' pivot='key' type='nominal' />
            <column-instance column='[__tableau_internal_object_id__].[adult_converted.csv_7120295E822D483F82FF342C3A717F56]' derivation='Count' name='[pcto:cnt:adult_converted.csv_7120295E822D483F82FF342C3A717F56:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0majz1a18968a71aozgur0vm611d].[Calculation_0875543964954628]' ordering-type='Field' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0majz1a18968a71aozgur0vm611d].[none:Calculation_0875543964782595:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_0875543964782595:nk]' member='&quot;Mexico&quot;' />
